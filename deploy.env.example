# Copy to deploy.env (git-ignored) and fill in.
STACK_NAME=isaacinthecloud-site
DOMAIN_NAME=example.com
HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
BUDGET_ALERT_EMAIL=alerts@example.com

# Local WordPress site that gets exported.
SOURCE_URL=http://example.test

# Optional
ENABLE_PRICING_PLAN=true   # CloudFront flat-rate Free plan
ATTACH_HOSTED_ZONE=false   # true only if the zone has 50 records or fewer
MONTHLY_BUDGET_USD=1
